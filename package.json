{
  "name": "smart-voices-keyboard",
  "version": "2.3.0",
  "description": "Cross-platform voice keyboard application with free open-source STT, Gemini API translation, unlimited clipboard, and Bangla/English/Banglish typing for Android, Windows, and macOS.",
  "author": "Sajjad Hossan",
  "license": "MIT",
  "main": "desktop/src/main/index.js",
  "bin": {
    "smartkey": "cli/smartkey.js"
  },
  "scripts": {
    "start": "electron desktop/src/main/index.js",
    "smartkey": "node cli/smartkey.js",
    "start:backend": "node backend/src/server.js",
    "dev:desktop": "electron desktop/src/main/index.js --dev",
    "build:desktop": "electron-builder --config desktop/electron-builder.yml --publish never",
    "build:windows": "electron-builder --win --x64 --config desktop/electron-builder.yml --publish never",
    "build:mac": "electron-builder --mac --universal --config desktop/electron-builder.yml --publish never",
    "test:phonetic": "node core/test/phonetic.test.js",
    "test:gemini": "node core/test/gemini.test.js",
    "test:desktop": "node core/test/desktop-ipc.test.js",
    "test:commands": "node core/test/voice-commands.test.js",
    "test:stt": "node core/test/stt-pipeline.test.js",
    "test:sync": "node core/test/sync-client.test.js",
    "test:livetranslate": "node core/test/live-translation.test.js",
    "test:prediction": "node core/test/prediction-engine.test.js",
    "test:theme": "node --test core/test/theme-engine.test.js",
    "test:autopunctuation": "node --test core/test/voice-autopunctuation.test.js",
    "test:backup": "node --test core/test/backup-crypto.test.js",
    "test:gesture": "node --test core/test/gesture-engine.test.js",
    "test:replacement": "node --test core/test/prediction-replacement.test.js",
    "test:quickmode": "node --test core/test/quick-mode-engine.test.js",
    "test:cli": "node --test core/test/smartkey-cli.test.js",
    "test:backend": "node backend/test/server.test.js",
    "test": "npm run test:phonetic && npm run test:gemini && npm run test:commands && npm run test:stt && npm run test:sync && npm run test:livetranslate && npm run test:prediction && npm run test:theme && npm run test:autopunctuation && npm run test:backup && npm run test:gesture && npm run test:replacement && npm run test:quickmode && npm run test:cli && npm run test:desktop && npm run test:backend"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "keywords": [
    "voice-keyboard",
    "speech-to-text",
    "bangla-keyboard",
    "banglish",
    "gemini-ai",
    "translation",
    "clipboard-manager",
    "android-ime",
    "windows",
    "macos"
  ]
}
