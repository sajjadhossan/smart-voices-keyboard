# Google Gemini API Key for AI Translation, Grammar Correction & Voice Commands
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Speech-to-Text Engine Selection
# Options: whisper-local | web-speech | vosk | whisper-api
STT_ENGINE=whisper-local

# Default Language Mode
# Options: bangla | english | banglish
DEFAULT_TYPING_MODE=bangla

# Default Translation Pair
TRANSLATE_SOURCE=en
TRANSLATE_TARGET=bn

# Desktop Hotkeys
HOTKEY_VOICE_DICTATION=Control+Alt+Space
HOTKEY_QUICK_TRANSLATE=Control+Alt+T
HOTKEY_CLIPBOARD_MANAGER=Control+Alt+V

# Auto-Paste Injected text into focused window
AUTO_PASTE_ENABLED=true
