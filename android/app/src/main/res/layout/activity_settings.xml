<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Voice Keyboard"
            android:textColor="#10B981"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="By Sajjad Hossan • Version 1.0.0"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Setup Step 1: Enable Keyboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ধাপ ১: কীবোর্ড সক্রিয় করুন"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="অ্যান্ড্রয়েড সেটিংস থেকে কীবোর্ড সক্রিয় করুন।"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnEnableKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#10B981"
                android:text="কীবোর্ড সক্রিয় করুন (Enable Keyboard)"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Setup Step 2: Select Keyboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ধাপ ২: ডিফল্ট কীবোর্ড নির্বাচন করুন"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSelectKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#334155"
                android:text="কীবোর্ড নির্বাচন করুন (Select Input Method)"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Gemini API Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini API Key"
                android:textColor="#10B981"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="অন-দ্য-ফ্লাই ইংরেজি-বাংলা অনুবাদ এবং AI ভয়েস ফিচারের জন্য প্রয়োজনীয়।"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#0F172A"
                android:hint="AIzaSy..."
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#10B981"
                android:text="API Key সংরক্ষণ করুন"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Clipboard Manager Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 আনলিমিটেড ক্লিপবোর্ড ম্যানেজার"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="কীবোর্ড চালুর সাথে সাথে যেকোনো অ্যাপ থেকে কপি করা টেক্সট স্বয়ংক্রিয়ভাবে ক্লিপবোর্ডে সংরক্ষিত হয়।"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClearClipboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#EF4444"
                android:text="ক্লিপবোর্ড মেমোরি খালি করুন"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
